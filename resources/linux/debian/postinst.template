# Symlink the Nyala Studio command to /usr/bin.
rm -f /usr/bin/@@NAME@@
ln -s /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@

# Register Nyala Studio as an optional editor.
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0

if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# Nyala Studio does not configure a package repository during the development
# bootstrap. A Nyala-hosted update channel requires a separate signing and
# release review before this script is enabled.
